# Скопируй файл в .env и укажи значения для своей среды.
# Не добавляй .env с реальными паролями и секретами в git.

# Настройки подключения к PostgreSQL.
DB_HOST=localhost
DB_PORT=5432
DB_USER=silknode
DB_PASS=change-me
DB_NAME=silknode

# Секреты для подписи access- и refresh-токенов.
# Задай для них разные случайные значения. Например, сгенерируй каждое командой:
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_ACCESS_SECRET_KEY=replace-with-a-random-secret
JWT_REFRESH_SECRET_KEY=replace-with-another-random-secret

# Алгоритм подписи JWT. Для этого проекта используется HS256.
JWT_ALGORITHM=HS256

# Срок действия access-токена в минутах.
ACCESS_TOKEN_EXPIRE_MINUTES=10

# Срок действия refresh-токена в днях.
REFRESH_TOKEN_EXPIRE_DAY=7
